# Inteligência Artificial (correspondência de tacoId na Tabela TACO)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# URL pública da aplicação (usada em links de confirmação e redefinição de senha)
APP_URL="MY_APP_URL"

# E-mails transacionais via Brevo (confirmação de cadastro e redefinição de senha)
BREVO_API_KEY="MY_BREVO_API_KEY"
BREVO_SENDER_EMAIL="no-reply@rotulofacil.app"

# Banco de dados Supabase PostgreSQL (usuário restrito com RLS ativo; não usar superusuário)
SUPABASE_DB_HOST="db.example.supabase.co"
SUPABASE_DB_PORT="5432"
SUPABASE_DB_USER="rotulofacil_app"
SUPABASE_DB_PASSWORD="CHANGE_ME_SUPABASE_PASSWORD"
SUPABASE_DB_NAME="postgres"
SUPABASE_DB_SSL_CA=""

# Criptografia AES-256-GCM das receitas (chave de 32 bytes em base64 = 44 caracteres)
DATA_ENCRYPTION_KEY="CHANGE_ME_BASE64_32_BYTES_KEY"
DATA_ENCRYPTION_KEY_VERSION="1"
DATA_ENCRYPTION_KEY_PREVIOUS=""

# Credenciais Firebase Admin para ambientes externos como Vercel (JSON da service account)
FIREBASE_SERVICE_ACCOUNT=""
